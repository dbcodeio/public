# 7-day supply-chain quarantine, mirroring the private repo. A newly published
# version cannot be resolved until it has been on the registry for a week, which
# is when most hijacked releases get caught and pulled. Needs pnpm >= 10.16,
# otherwise it silently does nothing.
#
# This is the second line of defence. pnpm-lock.yaml beside it is the first: it
# pins every transitive dependency by integrity hash, so `pnpm install
# --frozen-lockfile` resolves nothing at release time. The quarantine only
# matters when the lockfile is deliberately updated.
minimum-release-age=10080
